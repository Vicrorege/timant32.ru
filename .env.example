# Copy this file to .env and fill in values.
# Used by: docker compose, Vite dev proxy (npm start).

HOST_PORT=8067

# Last.fm — kept on the server (nginx / Vite proxy). Never shipped in the JS bundle.
LASTFM_API_KEY=your_lastfm_api_key_here
LASTFM_USER=tinant32

# Optional. Full URL to a private/public .ics feed.
# Frontend always calls same-origin GET /api/calendar; nginx proxies to this URL.
# Empty = /api/calendar returns 204 (widget stays hidden).
CALENDAR_ICS_URL=

# Optional status upstreams (defaults are fine for timant32.ru)
STATUS_MAIL_URL=https://mail.timant32.su/
STATUS_MC_URL=https://api.mcsrvstat.us/2/mc.timant32.ru
